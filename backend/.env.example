PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=elearning

# JWT (генеруй: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=change_me_64_bytes_hex
JWT_REFRESH_SECRET=change_me_another_64_bytes_hex

# ──────────────────────────────────────────────
# Cloudflare R2 (безкоштовно 10GB)
# 1. Зайди на dash.cloudflare.com → R2
# 2. Створи bucket з назвою "elearning"
# 3. API Tokens → Create Token → R2 Read+Write
# 4. Налаштуй публічний доступ через Custom Domain
# ──────────────────────────────────────────────
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY=your_r2_access_key_id
S3_SECRET_KEY=your_r2_secret_access_key
S3_BUCKET=elearning
S3_REGION=auto
S3_PUBLIC_URL=https://files.yourdomain.com
# ^ Публічний домен бакету (налаштовується в R2 → Custom Domains)
# Для тестування можна використати: https://pub-<hash>.r2.dev

# ──────────────────────────────────────────────
# AWS S3 (альтернатива R2)
# S3_ENDPOINT=  (залиш порожнім для AWS)
# S3_REGION=eu-central-1
# S3_ACCESS_KEY=AKIA...
# S3_SECRET_KEY=...
# ──────────────────────────────────────────────

# ──────────────────────────────────────────────
# LiqPay
# 1. Зареєструйся на liqpay.ua
# 2. Особистий кабінет → Бізнес → Магазини → Створити
# 3. Налаштування → API (там public і private key)
# ──────────────────────────────────────────────
LIQPAY_PUBLIC_KEY=your_liqpay_public_key
LIQPAY_PRIVATE_KEY=your_liqpay_private_key
# URL куди LiqPay надсилає результат (має бути публічний!)
LIQPAY_SERVER_URL=https://your-api.com/payments/callback
# URL куди перенаправляється юзер після оплати
LIQPAY_RESULT_URL=https://your-site.com/payment/result
