{
  "name": "elearning-backend",
  "version": "1.0.0",
  "scripts": {
    "build":            "nest build",
    "start":            "node dist/main",
    "start:dev":        "nest start --watch",
    "start:prod":       "NODE_ENV=production node dist/main",

    "migration:run":    "ts-node -r tsconfig-paths/register src/database/data-source.ts && typeorm migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm migration:revert -d src/database/data-source.ts",
    "migration:show":   "typeorm migration:show -d src/database/data-source.ts",

    "seed":             "ts-node --project tsconfig.json src/database/seed-runner.ts",
    "seed:fresh":       "npm run migration:revert && npm run migration:run && npm run seed"
  },
  "dependencies": {
    "@nestjs/common":                "^10.0.0",
    "@nestjs/core":                  "^10.0.0",
    "@nestjs/platform-express":      "^10.0.0",
    "@nestjs/jwt":                   "^10.0.0",
    "@nestjs/passport":              "^10.0.0",
    "@nestjs/typeorm":               "^10.0.0",
    "@nestjs/config":                "^3.0.0",
    "@nestjs/swagger":               "^7.0.0",
    "passport":                      "^0.6.0",
    "passport-jwt":                  "^4.0.1",
    "typeorm":                       "^0.3.17",
    "pg":                            "^8.11.0",
    "bcryptjs":                      "^2.4.3",
    "pdfkit":                        "^0.14.0",
    "class-validator":               "^0.14.0",
    "class-transformer":             "^0.5.1",
    "swagger-ui-express":            "^5.0.0",
    "reflect-metadata":              "^0.1.13",
    "rxjs":                          "^7.8.1",
    "multer":                        "^1.4.5-lts.1",
    "uuid":                          "^9.0.0",
    "@aws-sdk/client-s3":            "^3.400.0",
    "@aws-sdk/s3-request-presigner": "^3.400.0",
    "dotenv":                        "^16.0.0"
  },
  "devDependencies": {
    "@nestjs/cli":         "^10.0.0",
    "@nestjs/schematics":  "^10.0.0",
    "@types/passport-jwt": "^3.0.9",
    "@types/bcryptjs":     "^2.4.3",
    "@types/pdfkit":       "^0.12.0",
    "@types/express":      "^4.17.17",
    "@types/multer":       "^1.4.7",
    "@types/uuid":         "^9.0.0",
    "@types/node":         "^20.0.0",
    "typescript":          "^5.1.3",
    "ts-node":             "^10.9.1",
    "tsconfig-paths":      "^4.2.0"
  }
}
